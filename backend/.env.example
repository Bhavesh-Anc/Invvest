# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Database
DATABASE_URL=sqlite:///./data/quantedge.db

# Broker API Keys (Optional - for live trading)
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_secret_here

UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_secret_here

ANGEL_ONE_API_KEY=your_angel_one_api_key_here
ANGEL_ONE_CLIENT_ID=your_angel_one_client_id_here

# Redis Cache (Optional - for production)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=INFO

# CORS Origins (Add your frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
